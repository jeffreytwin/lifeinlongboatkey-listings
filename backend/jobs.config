{
  "jobs": [
    {
      "functionLocation": "/sync/run.jsw",
      "functionName": "hourlyIncremental",
      "description": "Hourly incremental MLSGrid sync for Longboat Key listings",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/sync/run.jsw",
      "functionName": "nightlyFull",
      "description": "Nightly full reconcile against MLSGrid active Longboat Key feed",
      "executionConfig": {
        "cronExpression": "0 3 * * *"
      }
    },
    {
      "functionLocation": "/sync/run.jsw",
      "functionName": "processMediaStep",
      "description": "Upload up to 5 pending photos for one listing per invocation",
      "executionConfig": {
        "cronExpression": "* * * * *"
      }
    }
  ]
}
