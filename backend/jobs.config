{
  "jobs": [
    {
      "functionLocation": "/sync/run.jsw",
      "functionName": "hourlyIncremental",
      "description": "Hourly incremental MLSGrid sync for Longboat Key listings",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/sync/run.jsw",
      "functionName": "nightlyFull",
      "description": "Nightly full reconcile against MLSGrid (verify-by-id)",
      "executionConfig": {
        "cronExpression": "30 3 * * *"
      }
    },
    {
      "functionLocation": "/sync/run.jsw",
      "functionName": "nightlyPurge",
      "description": "Nightly retention purge of SyncRuns (90d, keep newest 50) and SyncEvents (30d)",
      "executionConfig": {
        "cronExpression": "30 4 * * *"
      }
    },
    {
      "functionLocation": "/sync/run.jsw",
      "functionName": "processMediaStep",
      "description": "Mid-hour photo drain (Wix ignores sub-hourly schedules on this plan; the hourly sync drains too)",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    }
  ]
}
