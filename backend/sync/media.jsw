import wixData from 'wix-data';
import { mediaManager } from 'wix-media-backend';
const dataURLdecoder = require('image-data-uri');

const COLLECTION = 'HousesforSale';
const UPLOAD_FOLDER = '/JeffUploadsNew';
const MAX_ATTEMPTS = 3;
const QUEUE_SCAN_LIMIT = 50;
const PHOTOS_PER_STEP = 5;

function wait(ms) { return new Promise(r => setTimeout(r, ms)); }

async function uploadOne(url) {
    const encoded = await dataURLdecoder.encodeFromURL(url);
    const bufferInfo = await dataURLdecoder.decode(encoded);
    const buffer = await bufferInfo.dataBuffer;
    const fileInfo = await mediaManager.upload(UPLOAD_FOLDER, buffer, url, {
        mediaOptions: { mimeType: 'image/jpeg', mediaType: 'image' },
        metadataOptions: { isPrivate: false, isVisitorUpload: false }
    });
    return fileInfo.fileUrl;
}

async function uploadWithRetry(url) {
    let lastErr;
    for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt++) {
        try {
            return await uploadOne(url);
        } catch (err) {
            lastErr = err;
            await wait(500 * (attempt + 1));
        }
    }
    throw lastErr;
}

function isPendingItem(item) {
    return !!(item && typeof item.src === 'string' && item.src.startsWith('http'));
}

function findPendingIndex(gallery) {
    if (!Array.isArray(gallery)) return -1;
    return gallery.findIndex(isPendingItem);
}

export async function processMediaQueueStep() {
    const res = await wixData.query(COLLECTION)
        .descending('_createdDate')
        .limit(QUEUE_SCAN_LIMIT)
        .find({ suppressAuth: true });

    const target = res.items.find(row => findPendingIndex(row.listingImageGallery) >= 0);
    if (!target) return { processed: 0, failed: 0, listingId: null, message: 'no pending media' };

    const gallery = [...(target.listingImageGallery || [])];
    let processed = 0;
    let failed = 0;

    for (let i = 0; i < gallery.length && processed + failed < PHOTOS_PER_STEP; i++) {
        const item = gallery[i];
        if (!isPendingItem(item)) continue;
        const mlsUrl = item.src;
        try {
            const wixUrl = await uploadWithRetry(mlsUrl);
            gallery[i] = { ...item, src: wixUrl, mlsSourceUrl: mlsUrl };
            processed += 1;
        } catch (err) {
            console.log('processMediaQueueStep upload failed', mlsUrl, err && err.message);
            failed += 1;
        }
    }

    const firstWixSrc = gallery.find(g => g && g.src && !g.src.startsWith('http'));
    const newPrimary = firstWixSrc ? firstWixSrc.src : target.listingPrimaryImage;

    await wixData.update(COLLECTION, {
        ...target,
        listingImageGallery: gallery,
        listingPrimaryImage: newPrimary
    }, { suppressAuth: true });

    return {
        processed,
        failed,
        listingId: target._id,
        remaining: findPendingIndex(gallery) >= 0
    };
}

export function mediaSrcsToTrash(gallery) {
    if (!Array.isArray(gallery)) return [];
    return gallery.filter(i => i && i.type === 'Image' && i.src && !i.src.startsWith('http')).map(i => i.src);
}

export async function trashMedia(srcs) {
    if (!srcs.length) return;
    try {
        await mediaManager.moveFilesToTrash(srcs);
    } catch (err) {
        console.log('trashMedia error', err && err.message);
    }
}
