import wixData from 'wix-data';
import { mediaManager } from 'wix-media-backend';
import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';
import { logEvent } from 'backend/sync/events.js';
import { SITE_URL } from 'backend/sync/site-config.js';
const dataURLdecoder = require('image-data-uri');

const COLLECTION = 'HousesforSale';
const UPLOAD_FOLDER = '/JeffUploadsNew';
const MAX_ATTEMPTS = 3;
const QUEUE_SCAN_LIMIT = 200;
const DEFAULT_DEADLINE_MS = 50 * 1000;
const FLUSH_EVERY = 5;
// Photos upload in parallel via Promise.all instead of one-at-a-time. Each
// upload is HTTP-bound (MLSGrid GET + Wix media POST), so concurrent in-flight
// requests share the wall clock; ~3s per upload becomes ~3s for the whole
// batch. PARALLEL_UPLOADS=10 is conservative - browsers and servers commonly
// allow 100+ concurrent HTTP/2 requests, so we could push higher, but 10 is
// already a 10x throughput improvement over the old serial loop.
const PARALLEL_UPLOADS = 10;

const CHAIN_ENDPOINT = `${SITE_URL}/_functions/drainMedia`;
// 5s gives Wix enough time to dispatch the request and receive an initial
// HTTP ack from the chain endpoint before the parent function is terminated.
// 200ms wasn't enough - the next link rarely actually started, so the chain
// was breaking after each invocation and only the hourly cron's tail trigger
// kept any progress happening.
const CHAIN_DISPATCH_TIMEOUT_MS = 5000;

function wait(ms) { return new Promise(r => setTimeout(r, ms)); }

// MLSGrid's media server rate-limits bursts of photo downloads with HTTP
// 429 (seen on galleries of 30+ photos fetched 10 at a time). The URLs are
// fine; the fix is to slow down, not to re-fetch them. Retries on a 429
// back off longer, and once a batch sees one the row continues at
// RATE_LIMITED_PARALLEL with a pause between batches.
export function isRateLimited(err) {
    const m = err && err.message ? String(err.message) : String(err || '');
    return /\b429\b|too many requests/i.test(m);
}
const RATE_LIMIT_BACKOFF_MS = 2000;
export const RATE_LIMITED_PARALLEL = 2;
export const RATE_LIMIT_PAUSE_MS = 3000;
// Observed: once MLSGrid starts answering 429, it keeps doing so for a
// while even at 2 parallel with pauses. So after a rate-limited attempt a
// row is left alone for a cooldown that doubles with each consecutive
// rate-limited attempt: 5, 10, 20, 40, 60 (cap) minutes.
export function rateLimitCooldownMs(streak) {
    const n = Math.max(1, streak || 1);
    return Math.min(60, 5 * Math.pow(2, n - 1)) * 60 * 1000;
}

// The image library throws plain strings, not Error objects. Normalize so
// callers can read .message and attach fields.
function toError(err) {
    if (err instanceof Error) return err;
    const e = new Error(err && err.message ? String(err.message) : String(err));
    return e;
}

async function uploadOne(url) {
    const encoded = await dataURLdecoder.encodeFromURL(url);
    const bufferInfo = await dataURLdecoder.decode(encoded);
    const buffer = await bufferInfo.dataBuffer;
    const fileInfo = await mediaManager.upload(UPLOAD_FOLDER, buffer, url, {
        mediaOptions: { mimeType: 'image/jpeg', mediaType: 'image' },
        metadataOptions: { isPrivate: false, isVisitorUpload: false }
    });
    return fileInfo.fileUrl;
}

// Returns { fileUrl, rateLimited }: rateLimited is true when any attempt
// got a 429, even if a later attempt succeeded, so the caller can slow the
// rest of the gallery down instead of tripping the limit again.
export async function uploadWithRetryInfo(url) {
    let lastErr;
    let rateLimited = false;
    for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt++) {
        try {
            const fileUrl = await uploadOne(url);
            return { fileUrl, rateLimited };
        } catch (err) {
            lastErr = err;
            if (isRateLimited(err)) rateLimited = true;
            if (attempt < MAX_ATTEMPTS - 1) {
                await wait((isRateLimited(err) ? RATE_LIMIT_BACKOFF_MS : 500) * (attempt + 1));
            }
        }
    }
    const e = toError(lastErr);
    e.rateLimited = rateLimited;
    throw e;
}

export async function uploadWithRetry(url) {
    const r = await uploadWithRetryInfo(url);
    return r.fileUrl;
}

function isPendingItem(item) {
    return !!(item && typeof item.src === 'string' && item.src.startsWith('http'));
}

function findPendingIndex(gallery) {
    if (!Array.isArray(gallery)) return -1;
    return gallery.findIndex(isPendingItem);
}

async function findNextRowWithPending(excludeIds) {
    const res = await wixData.query(COLLECTION)
        .descending('_createdDate')
        .limit(QUEUE_SCAN_LIMIT)
        .find({ suppressAuth: true });
    return res.items.find(row =>
        findPendingIndex(row.listingImageGallery) >= 0 &&
        !(excludeIds && excludeIds.has(row._id))
    ) || null;
}

async function flushGallery(target, gallery) {
    const firstWixSrc = gallery.find(g => g && g.src && !g.src.startsWith('http'));
    const newPrimary = firstWixSrc ? firstWixSrc.src : target.listingPrimaryImage;
    const isComplete = isGalleryComplete(gallery);
    const wasPublished = !!target.isPublished;
    await wixData.update(COLLECTION, {
        ...target,
        listingImageGallery: gallery,
        listingPrimaryImage: newPrimary,
        // Sticky-true: once a row has been published, never un-publish it
        // mid-update (would yank live listings off the site). New rows reach
        // isPublished=true the moment the last raw https:// item migrates.
        isPublished: isComplete || wasPublished
    }, { suppressAuth: true });
}

function isGalleryComplete(gallery) {
    if (!Array.isArray(gallery) || !gallery.length) return false;
    return gallery.every(g => g && typeof g.src === 'string' && !g.src.startsWith('http'));
}

// Upload pending https:// gallery items to Wix media. Uploads run in parallel
// batches of PARALLEL_UPLOADS via Promise.all (~10x faster than serial), and
// the row is flushed after each batch so progress is durable even if Wix
// kills the function mid-loop. Loops across rows until the deadline is
// reached or no pending media remain.
export async function processMediaQueueStep(deadline, runKey) {
    const effectiveDeadline = deadline || (Date.now() + DEFAULT_DEADLINE_MS);
    let totalProcessed = 0;
    let totalFailed = 0;
    let lastListingId = null;
    // Rows that made zero upload progress this invocation (e.g. every stored
    // MLS URL is dead). Skip them for the rest of this run - otherwise
    // findNextRowWithPending returns the same wedged row forever, burning the
    // whole budget and chaining drainMedia endlessly. They get retried on the
    // next sync invocation.
    const stuck = new Set();

    while (Date.now() < effectiveDeadline) {
        const target = await findNextRowWithPending(stuck);
        if (!target) break;
        lastListingId = target._id;

        const gallery = [...(target.listingImageGallery || [])];
        const pendingIdxs = [];
        for (let i = 0; i < gallery.length; i++) {
            if (isPendingItem(gallery[i])) pendingIdxs.push(i);
        }

        let rowProcessed = 0;
        let rowFailed = 0; // from actual upload results, never from what was left unattempted
        let firstError = null;
        let parallel = PARALLEL_UPLOADS;
        let b = 0;
        while (b < pendingIdxs.length && Date.now() < effectiveDeadline) {
            const batch = pendingIdxs.slice(b, b + parallel);
            b += batch.length;
            let rateLimited = false;
            const results = await Promise.all(batch.map(async (idx) => {
                const item = gallery[idx];
                const mlsUrl = item.src;
                try {
                    const up = await uploadWithRetryInfo(mlsUrl);
                    if (up.rateLimited) rateLimited = true;
                    return { idx, wixUrl: up.fileUrl, mlsUrl, ok: true };
                } catch (err) {
                    console.log('processMediaQueueStep upload failed', mlsUrl, err && err.message);
                    if (!firstError) firstError = err && err.message ? err.message : String(err);
                    if (isRateLimited(err)) rateLimited = true;
                    return { idx, ok: false };
                }
            }));
            for (const r of results) {
                if (r.ok) {
                    gallery[r.idx] = { ...gallery[r.idx], src: r.wixUrl, mlsSourceUrl: r.mlsUrl };
                    totalProcessed += 1;
                    rowProcessed += 1;
                } else {
                    totalFailed += 1;
                    rowFailed += 1;
                }
            }
            await flushGallery(target, gallery);
            if (rateLimited && b < pendingIdxs.length) {
                parallel = RATE_LIMITED_PARALLEL;
                await wait(RATE_LIMIT_PAUSE_MS);
            }
        }
        // Throttled failure event (this queue is also driven by the
        // per-minute cron): first failure, then at most once an hour per row.
        // Only when uploads were actually attempted and all of them failed.
        if (rowFailed > 0 && rowProcessed === 0) {
            const last = target.lastPhotoFailAt ? new Date(target.lastPhotoFailAt).getTime() : 0;
            if (Date.now() - last > 60 * 60 * 1000) {
                await logEvent('warn', 'photos_failed', `${rowFailed} of ${pendingIdxs.length} pending photo${pendingIdxs.length === 1 ? '' : 's'} failed to upload for live row ${target.propertyAddress || target._id}${firstError ? `: ${firstError}` : ''}`, {
                    listingId: target._id, address: target.propertyAddress, village: target.village, mode: 'media', runKey: runKey || null,
                    details: { failed: rowFailed, processed: rowProcessed, pending: pendingIdxs.length, firstError: firstError || null }
                });
                try {
                    await wixData.update(COLLECTION, { ...target, listingImageGallery: gallery, lastPhotoFailAt: new Date() }, { suppressAuth: true });
                } catch (err) {
                    console.log('lastPhotoFailAt write failed for', target._id, err && err.message);
                }
            }
        }
        // A row is stuck only if we tried and got nowhere; a row we had no
        // time to attempt is simply pending for the next invocation.
        if (rowProcessed === 0 && rowFailed > 0) stuck.add(target._id);
        else if (rowProcessed === 0) break;
    }

    // Report remaining work excluding rows that are stuck on dead URLs, so
    // the drain chain stops instead of re-invoking itself against them
    // forever. Stuck rows get another chance on the next sync run.
    const moreLeft = await findNextRowWithPending(stuck);
    return {
        processed: totalProcessed,
        failed: totalFailed,
        listingId: lastListingId,
        remaining: !!moreLeft
    };
}

// Fire-and-forget: kicks off the next link of the photo-drain HTTP chain.
// Each link invokes /_functions/drainMedia which calls processMediaQueueStep
// in a fresh Wix invocation budget, then triggers another link if anything
// still remains. We use Promise.race against a short timeout so we return as
// soon as the request is dispatched, without waiting for the link to finish
// its work.
export async function triggerMediaDrain() {
    let secret;
    try {
        secret = await getSecret('SYNC_TRIGGER_SECRET');
    } catch (err) {
        console.log('triggerMediaDrain: secret read failed', err && err.message);
        return;
    }
    if (!secret) {
        console.log('triggerMediaDrain: SYNC_TRIGGER_SECRET not set');
        return;
    }

    const send = fetch(CHAIN_ENDPOINT, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'x-sync-secret': secret
        },
        body: '{}'
    }).catch(err => {
        console.log('triggerMediaDrain: fetch error', err && err.message);
    });

    await Promise.race([
        send,
        new Promise(r => setTimeout(r, CHAIN_DISPATCH_TIMEOUT_MS))
    ]);
}

export function mediaSrcsToTrash(gallery) {
    if (!Array.isArray(gallery)) return [];
    return gallery.filter(i => i && i.type === 'Image' && i.src && !i.src.startsWith('http')).map(i => i.src);
}

export async function trashMedia(srcs) {
    if (!srcs || !srcs.length) return;
    try {
        await mediaManager.moveFilesToTrash(srcs);
    } catch (err) {
        console.log('trashMedia error', err && err.message);
    }
}
