import wixData from 'wix-data';

// Per-neighborhood range stats for the HousesforSale-DynamicPages collection.
//
// Each HousesforSale listing carries a `village1` UUID that is the `_id` of its
// neighborhood row in HousesforSale-DynamicPages. We bucket the current active
// listings by that id and write min/max display ranges back onto the
// neighborhood row:
//   priceRangeActive    e.g. "$500s - $1M"   (from listingPricePure)
//   squareFeetActive    e.g. "1,200 - 4,100" (from squareFeet)
//   bedroomRangeActive  e.g. "2 - 4"         (from bedrooms)
//
// Formatting rules (active = current listings only):
//   Price - banded to a display token, always rounding *down* (never up) so a
//           range never overstates: nearest $100k below $1M ("$500s"), nearest
//           $1M at/above ("$2M").
//   Sqft  - floored to the $100 below, comma-grouped.
//   Beds  - integer min/max, no rounding.
//   All three collapse to a single token when low and high land equal
//   ("4", "$1M", "2,000"), and are null when the neighborhood has no usable
//   active data for that metric.

const HOUSES = 'HousesforSale';
const NEIGHBORHOODS = 'HousesforSale-DynamicPages';
const WRITE_CHUNK = 50;

function commafy(n) {
    return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

// Band a price and render the token. nearest $100k below $1M ("$500s");
// nearest $1M at/above ("$2M"). mode 'floor' rounds down (for the low end of a
// range, so it never overstates the starting price); mode 'round' (default)
// rounds to nearest. Values that resolve to $1M render as "$1M".
export function priceToken(value, mode = 'round') {
    if (typeof value !== 'number' || !isFinite(value) || value <= 0) return null;
    const snap = mode === 'floor' ? Math.floor : Math.round;
    const band = value < 1000000
        ? snap(value / 100000) * 100000
        : snap(value / 1000000) * 1000000;
    if (band >= 1000000) return `$${band / 1000000}M`;
    return `$${band / 1000}s`;
}

export function formatPriceRange(min, max) {
    const lo = priceToken(min, 'floor');
    const hi = priceToken(max, 'floor');
    if (!lo || !hi) return null;
    return lo === hi ? lo : `${lo} - ${hi}`;
}

export function formatSqftRange(min, max) {
    if (!isFinite(min) || !isFinite(max)) return null;
    const lo = Math.floor(min / 100) * 100;
    const hi = Math.floor(max / 100) * 100;
    return lo === hi ? commafy(lo) : `${commafy(lo)} - ${commafy(hi)}`;
}

export function formatBedroomRange(min, max) {
    if (!isFinite(min) || !isFinite(max)) return null;
    return min === max ? String(min) : `${min} - ${max}`;
}

// squareFeet is stored on HousesforSale as a comma-grouped string ("1,234"),
// and "0" for listings without a living area (e.g. vacant land). Parse back to
// a positive number, or null to exclude from the range.
function parseSqft(value) {
    if (value == null) return null;
    const n = parseInt(String(value).replace(/,/g, ''), 10);
    return isFinite(n) && n > 0 ? n : null;
}

function extend(agg, key, value) {
    const lo = `${key}Min`;
    const hi = `${key}Max`;
    agg[lo] = agg[lo] == null ? value : Math.min(agg[lo], value);
    agg[hi] = agg[hi] == null ? value : Math.max(agg[hi], value);
}

// Bucket every active HousesforSale listing by its village1 id, tracking the
// min/max of price, square feet, and bedrooms.
async function aggregateActiveByVillage() {
    const map = new Map();
    let skip = 0;
    while (true) {
        const res = await wixData.query(HOUSES)
            .fields('listingPricePure', 'squareFeet', 'bedrooms', 'village1')
            .limit(1000).skip(skip)
            .find({ suppressAuth: true });

        for (const row of res.items) {
            const key = row.village1;
            if (!key || typeof key !== 'string') continue;
            let agg = map.get(key);
            if (!agg) { agg = {}; map.set(key, agg); }

            const price = row.listingPricePure;
            if (typeof price === 'number' && isFinite(price) && price > 0) {
                extend(agg, 'price', price);
            }
            const sqft = parseSqft(row.squareFeet);
            if (sqft != null) {
                extend(agg, 'sqft', sqft);
            }
            const beds = row.bedrooms;
            if (typeof beds === 'number' && isFinite(beds) && beds > 0) {
                extend(agg, 'bed', beds);
            }
        }

        if (res.items.length < 1000) break;
        skip += res.items.length;
    }
    return map;
}

// Treat undefined / null / "" the same when diffing against computed ranges so
// a neighborhood that has (and had) no data isn't rewritten every run.
function norm(v) {
    return (v == null || v === '') ? null : v;
}

// ---------------------------------------------------------------------------
// Historical range ratchet.
//
// The neighborhoods collection also carries hand-curated all-time ranges:
//   priceRange   e.g. "$500k - $2M"
//   squareFeet   e.g. "1,200 - 4,100"
//   bedroomRange e.g. "2 - 4"
// These are an envelope of everything the neighborhood has seen. The sync only
// ever WIDENS them - when the current active range's band escapes the
// historical band - and preserves the untouched end's original text verbatim.
// Unparseable hand-written values are left alone (and logged). Blank fields
// are seeded from the current active range.

const HIST_PRICE_FIELD = 'priceRange';
const HIST_SQFT_FIELD = 'squareFeet';
const HIST_BED_FIELD = 'bedroomRange';

// "$500s" / "$500k" / "$1M" / "$1.5M" / "$1,500,000" / "750000" -> number.
function parsePriceToken(t) {
    if (typeof t !== 'string') return null;
    const s = t.trim().replace(/^\$/, '').replace(/,/g, '');
    let m = /^([0-9]+(?:\.[0-9]+)?)\s*[mM]$/.exec(s);
    if (m) return Math.round(parseFloat(m[1]) * 1000000);
    m = /^([0-9]+(?:\.[0-9]+)?)\s*[ksKS]$/.exec(s);
    if (m) return Math.round(parseFloat(m[1]) * 1000);
    m = /^([0-9]+)$/.exec(s);
    if (m) return parseInt(m[1], 10);
    return null;
}

// "1,200" / "1200" / "3" -> number. Used for both sqft and bedroom tokens.
function parseIntToken(t) {
    if (typeof t !== 'string') return null;
    const s = t.trim().replace(/,/g, '');
    const m = /^([0-9]+)$/.exec(s);
    return m ? parseInt(m[1], 10) : null;
}

function sqftToken(value) {
    return commafy(Math.floor(value / 100) * 100);
}

// Split "X - Y" (hyphen or en dash, or the word 'to') into end texts.
// A single token is a collapsed range (lo == hi).
function splitRange(text) {
    const parts = String(text).split(/\s*(?:-|–|\bto\b)\s*/).filter(Boolean);
    if (parts.length === 1) return { loText: parts[0], hiText: parts[0] };
    if (parts.length === 2) return { loText: parts[0], hiText: parts[1] };
    return null;
}

// Ratchet one historical range string outward against the active min/max.
// Returns the new string when a widen (or blank-seed) is needed, else null.
function widenHistoricalRange(existingText, activeMin, activeMax, parseToken, formatToken) {
    if (activeMin == null || activeMax == null) return null;

    // Compare at band level: format the active ends first, then parse them
    // back, so an active value inside the same display band never churns.
    const activeLoText = formatToken(activeMin);
    const activeHiText = formatToken(activeMax);
    const activeLo = parseToken(activeLoText);
    const activeHi = parseToken(activeHiText);
    if (activeLo == null || activeHi == null) return null;

    const current = norm(existingText);
    if (current == null) {
        return activeLoText === activeHiText ? activeLoText : `${activeLoText} - ${activeHiText}`;
    }

    const ends = splitRange(current);
    if (!ends) return null;
    const lo = parseToken(ends.loText);
    const hi = parseToken(ends.hiText);
    if (lo == null || hi == null) {
        console.log('historical range not parseable, leaving as-is:', current);
        return null;
    }

    const loText = activeLo < lo ? activeLoText : ends.loText;
    const hiText = activeHi > hi ? activeHiText : ends.hiText;
    if (loText === ends.loText && hiText === ends.hiText) return null;
    return loText === hiText ? loText : `${loText} - ${hiText}`;
}

// Recompute the three *Active range fields on every neighborhood row from the
// current active listings. Neighborhoods with no active listings have those
// fields cleared. Respects an optional deadline (ms epoch); if it runs out of
// budget mid-write it returns remaining: true so the caller can re-invoke.
export async function refreshVillageActiveRanges(deadline) {
    const map = await aggregateActiveByVillage();

    // The neighborhoods collection is small (~100 rows); load it in one query.
    const res = await wixData.query(NEIGHBORHOODS).limit(1000).find({ suppressAuth: true });
    const rows = res.items;

    const updates = [];
    for (const row of rows) {
        const agg = map.get(row._id) || {};
        const priceRangeActive = formatPriceRange(agg.priceMin, agg.priceMax);
        const squareFeetActive = formatSqftRange(agg.sqftMin, agg.sqftMax);
        const bedroomRangeActive = formatBedroomRange(agg.bedMin, agg.bedMax);

        // Ratchet the hand-curated all-time ranges outward when the active
        // range escapes them. null = no change needed.
        const widenedPrice = widenHistoricalRange(
            row[HIST_PRICE_FIELD], agg.priceMin, agg.priceMax,
            parsePriceToken, v => priceToken(v, 'floor'));
        const widenedSqft = widenHistoricalRange(
            row[HIST_SQFT_FIELD], agg.sqftMin, agg.sqftMax,
            parseIntToken, sqftToken);
        const widenedBeds = widenHistoricalRange(
            row[HIST_BED_FIELD], agg.bedMin, agg.bedMax,
            parseIntToken, v => String(v));

        if (norm(row.priceRangeActive) !== priceRangeActive ||
            norm(row.squareFeetActive) !== squareFeetActive ||
            norm(row.bedroomRangeActive) !== bedroomRangeActive ||
            widenedPrice != null || widenedSqft != null || widenedBeds != null) {
            const update = { ...row, priceRangeActive, squareFeetActive, bedroomRangeActive };
            if (widenedPrice != null) update[HIST_PRICE_FIELD] = widenedPrice;
            if (widenedSqft != null) update[HIST_SQFT_FIELD] = widenedSqft;
            if (widenedBeds != null) update[HIST_BED_FIELD] = widenedBeds;
            updates.push(update);
        }
    }

    let written = 0;
    for (let i = 0; i < updates.length; i += WRITE_CHUNK) {
        if (deadline && Date.now() > deadline) {
            return { villages: rows.length, changed: updates.length, written, remaining: true };
        }
        const chunk = updates.slice(i, i + WRITE_CHUNK);
        try {
            const bulk = await wixData.bulkUpdate(NEIGHBORHOODS, chunk, { suppressAuth: true });
            written += (bulk && bulk.updated) != null ? bulk.updated : chunk.length;
        } catch (err) {
            console.log('refreshVillageActiveRanges bulkUpdate failed at', i, err && err.message);
        }
    }

    return { villages: rows.length, changed: updates.length, written, remaining: false };
}
