import wixData from 'wix-data';
import { VILLAGE_SEED } from 'backend/sync/villages.seed';
import { invalidateVillageCache } from 'backend/sync/villages';

// Composite upsert key: matchPattern alone is no longer unique because
// street-qualified rows (e.g. 'bay isles' + streetPattern 'bayou') share a
// subdivision pattern with their generic sibling.
function seedKey(entry) {
    return `${entry.matchPattern || ''}||${entry.streetPattern || ''}`;
}

// Populates the `Villages` reference collection from the generated seed.
// Idempotent: uses matchPattern+streetPattern as the stable key and bulk-saves
// in chunks so the call completes well inside Wix's request budget.
export async function seedVillages() {
    const existing = await wixData.query('Villages').limit(1000).find({ suppressAuth: true });
    const byPattern = new Map();
    for (const item of existing.items) {
        if (item.matchPattern) byPattern.set(seedKey(item), item);
    }

    const toSave = VILLAGE_SEED.map(entry => {
        const current = byPattern.get(seedKey(entry));
        return current ? { ...current, ...entry } : { ...entry };
    });

    const chunkSize = 50;
    let inserted = 0;
    let updated = 0;
    for (let i = 0; i < toSave.length; i += chunkSize) {
        const chunk = toSave.slice(i, i + chunkSize);
        const res = await wixData.bulkSave('Villages', chunk, { suppressAuth: true });
        inserted += res.inserted || 0;
        updated += res.updated || 0;
    }

    invalidateVillageCache();
    return { total: toSave.length, inserted, updated };
}

// Deletes Villages rows whose matchPattern is not present in the seed.
// seedVillages only upserts, so legacy rows (pre-seed manual entries, retired
// villages) survive re-seeding and can shadow correct matches - a stale row
// with a high `order` wins matchVillage over the seeded entry. Run this after
// seedVillages to bring the collection exactly in line with the seed. Returns
// the deleted rows' key fields for review.
export async function pruneVillages() {
    const seedPatterns = new Set(VILLAGE_SEED.map(e => seedKey(e)));
    const existing = await wixData.query('Villages').limit(1000).find({ suppressAuth: true });

    const strays = existing.items.filter(item => !seedPatterns.has(seedKey(item)));
    const deleted = [];
    for (const row of strays) {
        try {
            await wixData.remove('Villages', row._id, { suppressAuth: true });
            deleted.push({
                matchPattern: row.matchPattern || null,
                villageName: row.villageName || null,
                order: row.order != null ? row.order : null
            });
        } catch (err) {
            console.log('pruneVillages remove failed for', row._id, err && err.message);
        }
    }

    invalidateVillageCache();
    return { scanned: existing.items.length, deleted: deleted.length, deletedRows: deleted };
}
