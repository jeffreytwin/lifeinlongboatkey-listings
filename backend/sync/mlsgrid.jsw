import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

const BASE = 'https://api.mlsgrid.com/v2/Property';
const ORIG_SYSTEM = 'mfrmls';
const POSTAL_CITY = 'Longboat Key';
const EXPAND = 'Media,Rooms,UnitTypes';
const PAGE_SIZE = 200;
const MAX_RETRIES = 4;

async function authHeader() {
    const token = await getSecret('MLSGRID_API_KEY');
    return { Authorization: `Bearer ${token}` };
}

function wait(ms) {
    return new Promise(r => setTimeout(r, ms));
}

async function fetchWithRetry(url, headers, attempt = 0) {
    try {
        const res = await fetch(url, { method: 'GET', headers });
        if (res.status >= 500 && attempt < MAX_RETRIES) {
            await wait(1000 * Math.pow(2, attempt));
            return fetchWithRetry(url, headers, attempt + 1);
        }
        if (!res.ok) {
            const body = await res.text();
            throw new Error(`MLSGrid ${res.status}: ${body.slice(0, 500)}`);
        }
        return res.json();
    } catch (err) {
        if (attempt < MAX_RETRIES) {
            await wait(1000 * Math.pow(2, attempt));
            return fetchWithRetry(url, headers, attempt + 1);
        }
        throw err;
    }
}

function buildFilter({ since, activeOnly }) {
    const parts = [
        `OriginatingSystemName eq '${ORIG_SYSTEM}'`,
        `PostalCity eq '${POSTAL_CITY}'`
    ];
    if (since) parts.push(`ModificationTimestamp gt ${since.toISOString()}`);
    if (activeOnly) parts.push(`StandardStatus eq 'Active'`);
    return parts.join(' and ');
}

export async function debugHydrate(listingId) {
    const headers = await authHeader();
    const filters = [
        `ListingId eq '${listingId}' and OriginatingSystemName eq '${ORIG_SYSTEM}'`,
        `ListingId eq '${listingId}'`,
        `ListingKey eq '${listingId}'`
    ];
    const results = [];
    for (const f of filters) {
        const url = `${BASE}?$filter=${encodeURIComponent(f)}&$top=1&$count=true`;
        try {
            const page = await fetchWithRetry(url, headers);
            const sample = page.value && page.value[0] ? {
                ListingId: page.value[0].ListingId,
                ListingKey: page.value[0].ListingKey,
                OriginatingSystemName: page.value[0].OriginatingSystemName,
                StandardStatus: page.value[0].StandardStatus,
                PostalCity: page.value[0].PostalCity,
                SubdivisionName: page.value[0].SubdivisionName
            } : null;
            results.push({ filter: f, count: page['@odata.count'], got: (page.value || []).length, sample });
        } catch (err) {
            results.push({ filter: f, error: err && err.message });
        }
    }
    return results;
}

export async function hydrateListing(listingId) {
    if (!listingId) return null;
    const headers = await authHeader();
    const filter = encodeURIComponent(
        `OriginatingSystemName eq '${ORIG_SYSTEM}' and ListingId eq '${listingId}'`
    );
    const url = `${BASE}?$filter=${filter}&$expand=${EXPAND}&$top=1`;
    const page = await fetchWithRetry(url, headers);
    if (Array.isArray(page.value) && page.value.length) return page.value[0];
    return null;
}

export async function fetchProperties({ since = null, activeOnly = false } = {}) {
    const headers = await authHeader();
    const filter = encodeURIComponent(buildFilter({ since, activeOnly }));
    let url = `${BASE}?$filter=${filter}&$expand=${EXPAND}&$top=${PAGE_SIZE}&$count=true`;

    const all = [];
    let requestCount = 0;
    let expectedCount = null;

    while (url) {
        const page = await fetchWithRetry(url, headers);
        requestCount += 1;
        if (expectedCount === null && typeof page['@odata.count'] === 'number') {
            expectedCount = page['@odata.count'];
        }
        if (Array.isArray(page.value)) all.push(...page.value);
        url = page['@odata.nextLink'] || null;
    }

    return { items: all, requestCount, expectedCount };
}
