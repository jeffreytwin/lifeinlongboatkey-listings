import wixData from 'wix-data';

let cache = null;

async function loadVillages() {
    if (cache) return cache;
    const res = await wixData.query('Villages').descending('order').limit(1000).find({ suppressAuth: true });
    cache = res.items.map(v => ({
        order: typeof v.order === 'number' ? v.order : 0,
        matchPattern: (v.matchPattern || '').toLowerCase(),
        streetPattern: (v.streetPattern || '').toLowerCase(),
        villageName: v.villageName,
        villageURL: v.villageURL,
        village1: v.village1,
        villageSortHelp: v.villageSortHelp || v.villageName,
        blueTag1: v.blueTag1 || '',
        purpleTag1: v.purpleTag1 || '',
        greenTag1: v.greenTag1 || ''
    })).filter(v => v.matchPattern);
    return cache;
}

export function invalidateVillageCache() {
    cache = null;
}

// streetText disambiguates communities that share a generic subdivision name
// (e.g. subdivision 'BAY ISLES' on Bayou Road/Sound is The Bayou, not the
// Harbor Section). Sync paths pass the MLS street fields; reclassify sweeps
// pass the stored propertyAddress. Rows without a streetPattern ignore it.
export async function matchVillage(subdivisionName, streetText) {
    const villages = await loadVillages();
    const needle = (subdivisionName || '').toLowerCase();
    if (!needle) return null;
    const street = (streetText || '').toLowerCase();
    return villages.find(v => {
        if (!needle.includes(v.matchPattern)) return false;
        if (v.streetPattern) return street.includes(v.streetPattern);
        return true;
    }) || null;
}
