import wixData from 'wix-data';
import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';
import { uploadWithRetry, trashMedia } from 'backend/sync/media';
import { hydrateListing } from 'backend/sync/mlsgrid';

const STAGGING = 'Stagging';
const HOUSES = 'HousesforSale';
const PARALLEL_UPLOADS = 10;
// Each per-row HTTP call gets its own ~59s Wix budget. Leave headroom for the
// row read/write that bookend the uploads.
const PER_ROW_DEADLINE_MS = 50 * 1000;
// Cron fan-out: how many per-row HTTP calls to dispatch concurrently. Each is
// awaited (not fire-and-forget), so dispatch is reliable.
const FAN_OUT_PARALLEL = 10;

const SITE_URL = 'https://www.lifeinlongboatkey.com';
const PROCESS_ROW_ENDPOINT = `${SITE_URL}/_functions/processStaggingRow`;

function isPending(item) {
    return !!(item && typeof item.src === 'string' && item.src.startsWith('http'));
}

function isGalleryComplete(gallery) {
    if (!Array.isArray(gallery) || !gallery.length) return false;
    return gallery.every(g => g && typeof g.src === 'string' && !g.src.startsWith('http'));
}

function sameTimestamp(a, b) {
    if (!a || !b) return false;
    return new Date(a).getTime() === new Date(b).getTime();
}

function galleryFromMedia(media) {
    if (!Array.isArray(media)) return [];
    return [...media].sort((a, b) => (a.Order || 0) - (b.Order || 0)).map(m => ({
        type: 'Image',
        title: m.LongDescription || '',
        src: m.MediaURL,
        order: m.Order,
        mlsModificationTimestamp: m.MediaModificationTimestamp || m.ModificationTimestamp || null
    }));
}

// Local copy of pipeline's mergeGallery. Importing it from pipeline.jsw would
// create a pipeline <-> stagging import cycle, which Wix's module cache
// handles badly (see the inlined-transform note in pipeline.jsw).
function mergeGalleryLocal(incoming, existing) {
    if (!Array.isArray(incoming)) return [];
    if (!Array.isArray(existing) || !existing.length) return incoming;
    const byMlsUrl = new Map();
    for (const e of existing) {
        const key = e && (e.mlsSourceUrl || (typeof e.src === 'string' && e.src.startsWith('http') ? e.src : null));
        if (key) byMlsUrl.set(key, e);
    }
    return incoming.map(inc => {
        const prev = byMlsUrl.get(inc.src);
        if (prev && prev.src && !prev.src.startsWith('http') && sameTimestamp(prev.mlsModificationTimestamp, inc.mlsModificationTimestamp)) {
            return { ...inc, src: prev.src, mlsSourceUrl: inc.src };
        }
        return inc;
    });
}

export async function countPendingStagging() {
    try {
        const res = await wixData.query(STAGGING).count({ suppressAuth: true });
        return res;
    } catch (err) {
        console.log('countPendingStagging failed', err && err.message);
        return 0;
    }
}

export async function getPendingStaggingRows(limit) {
    const res = await wixData.query(STAGGING)
        .ascending('_createdDate')
        .limit(limit || 200)
        .find({ suppressAuth: true });
    return res.items;
}

// Process a single Stagging row in this invocation: upload all its pending
// photos via internal Promise.all parallelism, flush progress between batches
// for durability, then if the gallery is fully wix-hosted promote the row to
// HousesforSale and delete it from Stagging.
export async function processOneStaggingRow(rowId) {
    if (!rowId) return { rowId, status: 'no_id', processed: 0, failed: 0 };

    const row = await wixData.get(STAGGING, rowId, { suppressAuth: true }).catch(() => null);
    if (!row) return { rowId, status: 'not_found', processed: 0, failed: 0 };

    const gallery = [...(row.listingImageGallery || [])];
    const pendingIdxs = [];
    for (let i = 0; i < gallery.length; i++) {
        if (isPending(gallery[i])) pendingIdxs.push(i);
    }

    let processed = 0;
    let failed = 0;
    const deadline = Date.now() + PER_ROW_DEADLINE_MS;

    for (let b = 0; b < pendingIdxs.length && Date.now() < deadline; b += PARALLEL_UPLOADS) {
        const batch = pendingIdxs.slice(b, b + PARALLEL_UPLOADS);
        const results = await Promise.all(batch.map(async (idx) => {
            const item = gallery[idx];
            const mlsUrl = item.src;
            try {
                const wixUrl = await uploadWithRetry(mlsUrl);
                return { idx, wixUrl, mlsUrl, ok: true };
            } catch (err) {
                console.log('processOneStaggingRow upload failed', mlsUrl, err && err.message);
                return { idx, ok: false };
            }
        }));
        for (const r of results) {
            if (r.ok) {
                gallery[r.idx] = { ...gallery[r.idx], src: r.wixUrl, mlsSourceUrl: r.mlsUrl };
                processed += 1;
            } else {
                failed += 1;
            }
        }
        // Flush progress to Stagging so a kill doesn't lose this batch.
        try {
            await wixData.update(STAGGING, { ...row, listingImageGallery: gallery }, { suppressAuth: true });
        } catch (err) {
            console.log('Stagging flush failed for', rowId, err && err.message);
        }
    }

    // Every pending upload failed with zero successes: the stored MLS media
    // URLs are likely stale (MLSGrid rotates/deletes the S3 objects when an
    // agent replaces photos, and the old links die). Re-hydrate the listing
    // for fresh URLs so the next wave can succeed instead of hammering dead
    // links forever.
    if (pendingIdxs.length && processed === 0 && failed > 0) {
        try {
            const raw = await hydrateListing(rowId);
            if (raw && Array.isArray(raw.Media) && raw.Media.length) {
                const fresh = mergeGalleryLocal(galleryFromMedia(raw.Media), gallery);
                await wixData.update(STAGGING, { ...row, listingImageGallery: fresh }, { suppressAuth: true });
                return { rowId, status: 'rehydrated', processed, failed };
            }
        } catch (err) {
            console.log('processOneStaggingRow rehydrate failed for', rowId, err && err.message);
        }
        return { rowId, status: 'partial', processed, failed };
    }

    if (!isGalleryComplete(gallery)) {
        return { rowId, status: 'partial', processed, failed };
    }

    // Gallery is fully wix-hosted - promote to HousesforSale and remove from
    // Stagging. Upsert in case HousesforSale already has this _id (handles a
    // re-run or update path).
    const firstWix = gallery.find(g => g && g.src && !g.src.startsWith('http'));
    const houseRecord = {
        ...row,
        listingImageGallery: gallery,
        listingPrimaryImage: firstWix ? firstWix.src : row.listingPrimaryImage,
        isPublished: true
    };

    try {
        const existing = await wixData.get(HOUSES, rowId, { suppressAuth: true }).catch(() => null);
        if (existing) {
            // Carry over the system _createdDate so we don't disturb sort order.
            await wixData.update(HOUSES, { ...existing, ...houseRecord }, { suppressAuth: true });
            // Staged photo swap: the live row kept its old gallery while the
            // replacement uploaded. Now that the new gallery is live, trash
            // the wix files it no longer references - after the update, so
            // the row never points at trashed media.
            const keep = new Set(gallery.filter(g => g && typeof g.src === 'string' && !g.src.startsWith('http')).map(g => g.src));
            const orphaned = (existing.listingImageGallery || [])
                .filter(g => g && typeof g.src === 'string' && !g.src.startsWith('http') && !keep.has(g.src))
                .map(g => g.src);
            if (orphaned.length) await trashMedia(orphaned);
        } else {
            await wixData.insert(HOUSES, houseRecord, { suppressAuth: true });
        }
        await wixData.remove(STAGGING, rowId, { suppressAuth: true });
        return { rowId, status: 'promoted', processed, failed };
    } catch (err) {
        console.log('promotion failed for', rowId, err && err.message);
        return { rowId, status: 'promote_failed', processed, failed, error: err && err.message };
    }
}

// Hourly cron's drain step. Pulls up to N pending Stagging rows and dispatches
// concurrent HTTP calls to /_functions/processStaggingRow. Each call gets its
// own fresh ~59s Wix invocation budget, so we get real parallelism instead of
// the single-process budget ceiling. The cron awaits each call (not fire-and-
// forget), which makes dispatch deterministic.
export async function drainStaggingFanOut(deadline) {
    const effectiveDeadline = deadline || (Date.now() + 50 * 1000);
    let secret;
    try {
        secret = await getSecret('SYNC_TRIGGER_SECRET');
    } catch (err) {
        console.log('drainStaggingFanOut: secret read failed', err && err.message);
        return { promoted: 0, partial: 0, processed: 0, failed: 0 };
    }
    if (!secret) {
        console.log('drainStaggingFanOut: SYNC_TRIGGER_SECRET not set');
        return { promoted: 0, partial: 0, processed: 0, failed: 0 };
    }

    let totalPromoted = 0;
    let totalPartial = 0;
    let totalProcessed = 0;
    let totalFailed = 0;

    while (Date.now() < effectiveDeadline) {
        // Each iteration pulls the next FAN_OUT_PARALLEL pending rows and
        // dispatches concurrent per-row HTTP calls. wixData query happens
        // every loop so a row that was promoted by a previous wave isn't
        // re-picked.
        const pending = await getPendingStaggingRows(FAN_OUT_PARALLEL);
        if (!pending.length) break;

        const results = await Promise.all(pending.map(async (row) => {
            try {
                const r = await fetch(PROCESS_ROW_ENDPOINT, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-sync-secret': secret
                    },
                    body: JSON.stringify({ rowId: row._id })
                });
                if (!r.ok) {
                    const body = await r.text();
                    return { rowId: row._id, status: 'http_error', http: r.status, body: body.slice(0, 200) };
                }
                return await r.json();
            } catch (err) {
                return { rowId: row._id, status: 'fetch_error', error: err && err.message };
            }
        }));

        for (const r of results) {
            if (r.status === 'promoted') totalPromoted += 1;
            else if (r.status === 'partial') totalPartial += 1;
            totalProcessed += (r.processed || 0);
            totalFailed += (r.failed || 0);
        }

        // If no progress this wave (all errored or all partial with 0 done),
        // bail out so we don't burn the rest of the budget hammering broken
        // rows. A rehydrated row counts as progress: its URLs are fresh now,
        // so the next wave has a real chance of succeeding.
        const madeProgress = results.some(r => r.status === 'promoted' || r.status === 'rehydrated' || (r.processed || 0) > 0);
        if (!madeProgress) break;
    }

    return { promoted: totalPromoted, partial: totalPartial, processed: totalProcessed, failed: totalFailed };
}
