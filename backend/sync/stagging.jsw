import wixData from 'wix-data';
import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';
import { uploadWithRetry, trashMedia } from 'backend/sync/media';
import { hydrateListing } from 'backend/sync/mlsgrid';
import { logEvent } from 'backend/sync/events.js';
import { SITE_URL } from 'backend/sync/site-config.js';

const STAGGING = 'Stagging';
const HOUSES = 'HousesforSale';
const PARALLEL_UPLOADS = 10;
// Each per-row HTTP call gets its own ~59s Wix budget. Leave headroom for the
// row read/write that bookend the uploads.
const PER_ROW_DEADLINE_MS = 50 * 1000;
// A parent (cron/runSync) awaiting a wave must not be held past its own
// kill: it races each wave against its remaining budget and moves on;
// children keep working in their own invocations.
// The first wave is dispatched whenever any time remains (dispatch is
// what matters - children have their own budget); later waves need this
// much left so their results can be collected.
const MIN_WAVE_BUDGET_MS = 8 * 1000;
// Skip the post-loop MLSGrid re-fetch when less than this remains: it is
// the one thing after the upload loop that can take seconds.
const HYDRATE_MIN_MS = 4 * 1000;
// Photo-failure events are written on transitions only (first failure,
// every Nth consecutive failure, error signature change, recovery) so one
// stuck row cannot flood SyncEvents from the per-minute cron.
const FAIL_EVENT_EVERY = 10;
// Cron fan-out: how many per-row HTTP calls to dispatch concurrently. Each is
// awaited (not fire-and-forget), so dispatch is reliable.
const FAN_OUT_PARALLEL = 10;

const PROCESS_ROW_ENDPOINT = `${SITE_URL}/_functions/processStaggingRow`;

function isPending(item) {
    return !!(item && typeof item.src === 'string' && item.src.startsWith('http'));
}

function isGalleryComplete(gallery) {
    if (!Array.isArray(gallery) || !gallery.length) return false;
    return gallery.every(g => g && typeof g.src === 'string' && !g.src.startsWith('http'));
}

function sameTimestamp(a, b) {
    if (!a || !b) return false;
    return new Date(a).getTime() === new Date(b).getTime();
}

function galleryFromMedia(media) {
    if (!Array.isArray(media)) return [];
    return [...media].sort((a, b) => (a.Order || 0) - (b.Order || 0)).map(m => ({
        type: 'Image',
        title: m.LongDescription || '',
        src: m.MediaURL,
        order: m.Order,
        mlsModificationTimestamp: m.MediaModificationTimestamp || m.ModificationTimestamp || null
    }));
}

// Local copy of pipeline's mergeGallery. Importing it from pipeline.jsw would
// create a pipeline <-> stagging import cycle, which Wix's module cache
// handles badly (see the inlined-transform note in pipeline.jsw).
function mergeGalleryLocal(incoming, existing) {
    if (!Array.isArray(incoming)) return [];
    if (!Array.isArray(existing) || !existing.length) return incoming;
    const byMlsUrl = new Map();
    for (const e of existing) {
        const key = e && (e.mlsSourceUrl || (typeof e.src === 'string' && e.src.startsWith('http') ? e.src : null));
        if (key) byMlsUrl.set(key, e);
    }
    return incoming.map(inc => {
        const prev = byMlsUrl.get(inc.src);
        if (prev && prev.src && !prev.src.startsWith('http') && sameTimestamp(prev.mlsModificationTimestamp, inc.mlsModificationTimestamp)) {
            return { ...inc, src: prev.src, mlsSourceUrl: inc.src };
        }
        return inc;
    });
}

export async function countPendingStagging() {
    try {
        const res = await wixData.query(STAGGING).count({ suppressAuth: true });
        return res;
    } catch (err) {
        console.log('countPendingStagging failed', err && err.message);
        return 0;
    }
}

export async function getPendingStaggingRows(limit) {
    const res = await wixData.query(STAGGING)
        .ascending('_createdDate')
        .limit(limit || 200)
        .find({ suppressAuth: true });
    return res.items;
}

// Process a single Stagging row in this invocation: upload all its pending
// photos via internal Promise.all parallelism, flush progress between batches
// for durability, then if the gallery is fully wix-hosted promote the row to
// HousesforSale and delete it from Stagging.
// runKey (optional): the run whose fan-out dispatched this call, so the
// events written here join to it. budgetMs (optional, informational): how
// long the caller will wait for the result; the child keeps its own full
// budget because its progress is durable whether or not the caller waits.
export async function processOneStaggingRow(rowId, runKey, budgetMs) {
    if (!rowId) return { rowId, status: 'no_id', processed: 0, failed: 0 };

    const row = await wixData.get(STAGGING, rowId, { suppressAuth: true }).catch(() => null);
    if (!row) return { rowId, status: 'not_found', processed: 0, failed: 0 };

    const gallery = [...(row.listingImageGallery || [])];
    const pendingIdxs = [];
    for (let i = 0; i < gallery.length; i++) {
        if (isPending(gallery[i])) pendingIdxs.push(i);
    }

    let processed = 0;
    let failed = 0;
    const failures = []; // { url, error } samples for the event log
    // The child runs in its own invocation with its own budget. The parent
    // does not wait past its deadline (it races each wave), so the child
    // is not shortened to the parent's remaining time: a wave dispatched
    // late still gets a full upload budget and its progress is durable.
    const deadline = Date.now() + PER_ROW_DEADLINE_MS;
    const ctx = { listingId: rowId, address: row.propertyAddress, village: row.village, mode: 'drain', runKey: runKey || null };
    // Failure bookkeeping carried on the row (see FAIL_EVENT_EVERY).
    let failStreak = typeof row.photoFailStreak === 'number' ? row.photoFailStreak : 0;
    const prevSignature = row.photoFailSignature || null;

    for (let b = 0; b < pendingIdxs.length && Date.now() < deadline; b += PARALLEL_UPLOADS) {
        const batch = pendingIdxs.slice(b, b + PARALLEL_UPLOADS);
        const results = await Promise.all(batch.map(async (idx) => {
            const item = gallery[idx];
            const mlsUrl = item.src;
            try {
                const wixUrl = await uploadWithRetry(mlsUrl);
                return { idx, wixUrl, mlsUrl, ok: true };
            } catch (err) {
                console.log('processOneStaggingRow upload failed', mlsUrl, err && err.message);
                if (failures.length < 5) failures.push({ url: mlsUrl, error: err && err.message ? err.message : String(err) });
                return { idx, ok: false };
            }
        }));
        for (const r of results) {
            if (r.ok) {
                gallery[r.idx] = { ...gallery[r.idx], src: r.wixUrl, mlsSourceUrl: r.mlsUrl };
                processed += 1;
            } else {
                failed += 1;
            }
        }
        // Flush progress to Stagging so a kill doesn't lose this batch.
        try {
            await wixData.update(STAGGING, { ...row, listingImageGallery: gallery }, { suppressAuth: true });
        } catch (err) {
            console.log('Stagging flush failed for', rowId, err && err.message);
        }
    }

    // Failure state + throttled events. Written with the row's own flush so
    // no extra write happens on the success path.
    const signature = failures.length ? String(failures[0].error).slice(0, 120) : null;
    let failState = null;
    if (failed > 0 && processed === 0) {
        failStreak += 1;
        failState = { photoFailStreak: failStreak, photoFailSignature: signature, lastPhotoFailAt: new Date() };
        const transition = failStreak === 1 || failStreak % FAIL_EVENT_EVERY === 0 || (signature && signature !== prevSignature);
        if (transition) {
            await logEvent('warn', 'photos_failed', `${failed} of ${pendingIdxs.length} pending photo${pendingIdxs.length === 1 ? '' : 's'} failed to upload for ${row.propertyAddress || rowId}${signature ? `: ${signature}` : ''}${failStreak > 1 ? ` (${failStreak} consecutive attempts)` : ''}`, {
                ...ctx,
                details: { failed, processed, pending: pendingIdxs.length, galleryTotal: gallery.length, samples: failures, failStreak, stagedSince: row._createdDate || null }
            });
        }
    } else if (failed > 0) {
        // Partial progress: not a streak, one note the first time only.
        failState = { photoFailStreak: 0, photoFailSignature: signature, lastPhotoFailAt: new Date() };
        if (failStreak === 0 && !prevSignature) {
            await logEvent('warn', 'photos_failed', `${failed} of ${pendingIdxs.length} pending photo${pendingIdxs.length === 1 ? '' : 's'} failed to upload for ${row.propertyAddress || rowId}${signature ? `: ${signature}` : ''}; ${processed} succeeded, the rest will be retried`, {
                ...ctx,
                details: { failed, processed, pending: pendingIdxs.length, galleryTotal: gallery.length, samples: failures, stagedSince: row._createdDate || null }
            });
        }
        failStreak = 0;
    } else if (processed > 0 && (failStreak > 0 || prevSignature)) {
        failState = { photoFailStreak: 0, photoFailSignature: null, lastPhotoFailAt: row.lastPhotoFailAt || null };
        await logEvent('info', 'photos_recovered', `Photo uploads recovered for ${row.propertyAddress || rowId} after ${failStreak} failed attempt${failStreak === 1 ? '' : 's'}`, {
            ...ctx, details: { processed, previousStreak: failStreak, previousError: prevSignature }
        });
        failStreak = 0;
    }
    if (failState) {
        Object.assign(row, failState);
        try {
            await wixData.update(STAGGING, { ...row, listingImageGallery: gallery }, { suppressAuth: true });
        } catch (err) {
            console.log('Stagging fail-state flush failed for', rowId, err && err.message);
        }
    }

    // Every pending upload failed with zero successes: the stored MLS media
    // URLs are likely stale (MLSGrid rotates/deletes the S3 objects when an
    // agent replaces photos, and the old links die). Re-hydrate the listing
    // for fresh URLs so the next wave can succeed instead of hammering dead
    // links forever - unless the listing has left the market, in which case
    // drop it (the nightly full also does this, but here we already know).
    if (pendingIdxs.length && processed === 0 && failed > 0) {
        if (deadline - Date.now() < HYDRATE_MIN_MS) {
            // Out of budget for the re-fetch; the next attempt does it.
            return { rowId, status: 'partial', processed, failed };
        }
        try {
            // One retry at most: this runs inside the caller's budget, and a
            // broken key or an MLSGrid outage must not cost 15s of backoff
            // on every attempt of every stuck row.
            const raw = await hydrateListing(rowId, { maxRetries: 1 });
            const mlsStatus = raw ? (raw.StandardStatus || '') : '';
            if (raw && mlsStatus && mlsStatus.toLowerCase() !== 'active') {
                // A photo-swap round for a LIVE listing shares its hosted
                // files with the HousesforSale row (mergeGallery maps
                // unchanged photos to the live srcs). Never trash those
                // here: drop the staged copy only, and let the next sync
                // remove the live row and its media together.
                const live = await wixData.get(HOUSES, rowId, { suppressAuth: true }).catch(() => null);
                const wixSrcs = live ? [] : gallery.filter(g => g && typeof g.src === 'string' && !g.src.startsWith('http')).map(g => g.src);
                await wixData.remove(STAGGING, rowId, { suppressAuth: true });
                if (wixSrcs.length) await trashMedia(wixSrcs);
                await logEvent('info', 'unstage', live
                    ? `Abandoned the pending photo swap for ${row.propertyAddress || rowId}: Status changed to ${mlsStatus}; the live listing is removed by the next sync`
                    : `Dropped staged (never published) listing ${row.propertyAddress || rowId}: Status changed to ${mlsStatus} while its photos were still failing`, {
                    ...ctx,
                    details: { reason: `Status changed to ${mlsStatus}`, reasonCode: 'status_change', mls: { status: mlsStatus }, photosTrashed: wixSrcs.length, failStreak, stagedSince: row._createdDate || null, wasLive: !!live }
                });
                return { rowId, status: 'unstaged', processed, failed };
            }
            if (raw && Array.isArray(raw.Media) && raw.Media.length) {
                const fresh = mergeGalleryLocal(galleryFromMedia(raw.Media), gallery);
                await wixData.update(STAGGING, { ...row, listingImageGallery: fresh }, { suppressAuth: true });
                if (failStreak === 1 || failStreak % FAIL_EVENT_EVERY === 0) {
                    await logEvent('info', 'rehydrate', `Every pending photo failed for ${row.propertyAddress || rowId}; refreshed ${fresh.length} photo URLs from MLSGrid for the next attempt (MLS status ${mlsStatus || 'unknown'})`, {
                        ...ctx,
                        details: { photos: fresh.length, mlsStatus: mlsStatus || null, failStreak, stagedSince: row._createdDate || null }
                    });
                }
                return { rowId, status: 'rehydrated', processed, failed };
            }
            if (failStreak === 1 || failStreak % FAIL_EVENT_EVERY === 0) {
                await logEvent('warn', 'rehydrate', `Every pending photo failed for ${row.propertyAddress || rowId} and MLSGrid ${raw ? 'returned no media' : 'no longer returns the listing'}; it will be retried`, {
                    ...ctx,
                    details: { mlsFound: !!raw, mlsStatus: mlsStatus || null, failStreak, stagedSince: row._createdDate || null }
                });
            }
        } catch (err) {
            console.log('processOneStaggingRow rehydrate failed for', rowId, err && err.message);
            // Same transition throttle as photos_failed, plus a change in the
            // error text, so an outage costs one event per stuck row, not one
            // per attempt.
            const errText = String(err && err.message ? err.message : err).slice(0, 120);
            const errChanged = errText !== (row.rehydrateErrorSignature || null);
            if (failStreak === 1 || failStreak % FAIL_EVENT_EVERY === 0 || errChanged) {
                await logEvent('error', 'rehydrate', `Re-fetch from MLSGrid failed for ${row.propertyAddress || rowId}: ${errText}${failStreak > 1 ? ` (${failStreak} consecutive attempts)` : ''}`, {
                    ...ctx, details: { error: errText, failStreak }
                });
                if (errChanged) {
                    await wixData.update(STAGGING, { ...row, listingImageGallery: gallery, rehydrateErrorSignature: errText }, { suppressAuth: true }).catch(() => null);
                }
            }
        }
        return { rowId, status: 'partial', processed, failed };
    }

    if (!isGalleryComplete(gallery)) {
        return { rowId, status: 'partial', processed, failed };
    }

    // Gallery is fully wix-hosted - promote to HousesforSale and remove from
    // Stagging. Upsert in case HousesforSale already has this _id (handles a
    // re-run or update path).
    const firstWix = gallery.find(g => g && g.src && !g.src.startsWith('http'));
    const { photoFailStreak, photoFailSignature, lastPhotoFailAt, rehydrateErrorSignature, ...cleanRow } = row;
    const houseRecord = {
        ...cleanRow,
        listingImageGallery: gallery,
        listingPrimaryImage: firstWix ? firstWix.src : row.listingPrimaryImage,
        isPublished: true
    };

    try {
        const existing = await wixData.get(HOUSES, rowId, { suppressAuth: true }).catch(() => null);
        if (existing) {
            // Carry over the system _createdDate so we don't disturb sort order.
            await wixData.update(HOUSES, { ...existing, ...houseRecord }, { suppressAuth: true });
            // Staged photo swap: the live row kept its old gallery while the
            // replacement uploaded. Now that the new gallery is live, trash
            // the wix files it no longer references - after the update, so
            // the row never points at trashed media.
            const keep = new Set(gallery.filter(g => g && typeof g.src === 'string' && !g.src.startsWith('http')).map(g => g.src));
            const orphaned = (existing.listingImageGallery || [])
                .filter(g => g && typeof g.src === 'string' && !g.src.startsWith('http') && !keep.has(g.src))
                .map(g => g.src);
            if (orphaned.length) await trashMedia(orphaned);
        } else {
            await wixData.insert(HOUSES, houseRecord, { suppressAuth: true });
        }
        await wixData.remove(STAGGING, rowId, { suppressAuth: true });
        await logEvent('info', 'promote', existing
            ? `Published photo swap for ${row.propertyAddress || rowId} (${gallery.length} photos live)`
            : `Published new listing ${row.propertyAddress || rowId} (${row.village || 'no village'}, ${row.listingPrice || 'no price'}, ${gallery.length} photos)`, {
            ...ctx,
            details: { photos: gallery.length, uploadedThisCall: processed, wasLive: !!existing, price: row.listingPricePure, stagedSince: row._createdDate || null }
        });
        return { rowId, status: 'promoted', processed, failed };
    } catch (err) {
        console.log('promotion failed for', rowId, err && err.message);
        await logEvent('error', 'promote_failed', `Promotion to HousesforSale failed for ${row.propertyAddress || rowId}: ${err && err.message ? err.message : err}`, {
            ...ctx, details: { error: err && err.message ? err.message : String(err), photos: gallery.length }
        });
        return { rowId, status: 'promote_failed', processed, failed, error: err && err.message };
    }
}

// Hourly cron's drain step. Pulls up to N pending Stagging rows and dispatches
// concurrent HTTP calls to /_functions/processStaggingRow. Each call gets its
// own fresh ~59s Wix invocation budget, so we get real parallelism instead of
// the single-process budget ceiling. The cron awaits each call (not fire-and-
// forget), which makes dispatch deterministic.
export async function drainStaggingFanOut(deadline, runKey) {
    const effectiveDeadline = deadline || (Date.now() + 50 * 1000);
    const empty = { promoted: 0, partial: 0, processed: 0, failed: 0, httpErrors: 0, stalled: false, waves: 0 };
    let secret;
    try {
        secret = await getSecret('SYNC_TRIGGER_SECRET');
    } catch (err) {
        console.log('drainStaggingFanOut: secret read failed', err && err.message);
        return { ...empty, secretMissing: true, secretError: err && err.message ? err.message : String(err) };
    }
    if (!secret) {
        console.log('drainStaggingFanOut: SYNC_TRIGGER_SECRET not set');
        return { ...empty, secretMissing: true };
    }

    let totalPromoted = 0;
    let totalPartial = 0;
    let totalProcessed = 0;
    let totalFailed = 0;
    let httpErrors = 0;
    let waves = 0;
    let lateWaves = 0;
    let stalled = false;
    let stalledRows = null;
    const errorSamples = [];

    // Each row is attempted at most once per invocation: a row that came
    // back 'rehydrated' or 'partial' would otherwise be re-picked (oldest
    // first) wave after wave, burning the budget on one dead-URL listing
    // and making "every 10th attempt" mean every 10th wave, not tick.
    const tried = new Set();
    while (true) {
        const remaining = effectiveDeadline - Date.now();
        if (remaining <= 0) break;
        if (waves > 0 && remaining < MIN_WAVE_BUDGET_MS) break;
        // Each iteration pulls the next FAN_OUT_PARALLEL pending rows not yet
        // tried and dispatches concurrent per-row HTTP calls. The query runs
        // every loop so a row promoted by a previous wave isn't re-picked.
        const candidates = await getPendingStaggingRows(FAN_OUT_PARALLEL + tried.size);
        const pending = candidates.filter(r => !tried.has(r._id)).slice(0, FAN_OUT_PARALLEL);
        if (!pending.length) break;
        for (const r of pending) tried.add(r._id);

        waves += 1;
        const budgetMs = effectiveDeadline - Date.now();
        // Children stop before budgetMs on their own, but an in-flight upload
        // batch or a slow MLSGrid re-fetch can still overrun. Never let a
        // late child hold this invocation past its deadline: their progress
        // is durable in their own invocation, so treat them as 'late'.
        const waveTimeout = new Promise(resolve => setTimeout(() => resolve(null), budgetMs));
        const waveResults = Promise.all(pending.map(async (row) => {
            try {
                const r = await fetch(PROCESS_ROW_ENDPOINT, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-sync-secret': secret
                    },
                    body: JSON.stringify({ rowId: row._id, runKey: runKey || null, budgetMs })
                });
                if (!r.ok) {
                    const body = await r.text();
                    return { rowId: row._id, status: 'http_error', http: r.status, body: body.slice(0, 200) };
                }
                return await r.json();
            } catch (err) {
                return { rowId: row._id, status: 'fetch_error', error: err && err.message };
            }
        }));
        const results = await Promise.race([waveResults, waveTimeout]);
        if (!results) {
            // Wave timed out: out of budget either way. Not a stall - the
            // children are still working.
            lateWaves += 1;
            break;
        }

        for (const r of results) {
            if (r.status === 'promoted') totalPromoted += 1;
            else if (r.status === 'partial') totalPartial += 1;
            else if (r.status === 'http_error' || r.status === 'fetch_error') {
                httpErrors += 1;
                if (errorSamples.length < 3) errorSamples.push({ rowId: r.rowId, status: r.http || null, error: r.error || r.body || null, endpoint: PROCESS_ROW_ENDPOINT });
            }
            totalProcessed += (r.processed || 0);
            totalFailed += (r.failed || 0);
        }

        // If no progress this wave (all errored or all partial with 0 done),
        // bail out so we don't burn the rest of the budget hammering broken
        // rows. A rehydrated or unstaged row counts as progress: its URLs
        // are fresh now (or it is gone), so the next wave can move on.
        const madeProgress = results.some(r => r.status === 'promoted' || r.status === 'rehydrated' || r.status === 'unstaged' || (r.processed || 0) > 0);
        if (!madeProgress) {
            stalled = true;
            stalledRows = results.map(r => ({ rowId: r.rowId, status: r.status }));
            break;
        }
    }

    return {
        promoted: totalPromoted, partial: totalPartial, processed: totalProcessed, failed: totalFailed,
        httpErrors, errorSamples, stalled, stalledRows, waves, lateWaves
    };
}
