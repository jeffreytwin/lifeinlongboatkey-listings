import wixData from 'wix-data';
import { runSync, transformListing, mergeGallery, bootstrap } from 'backend/sync/pipeline';
import { hydrateListing, debugHydrate, peekFeed } from 'backend/sync/mlsgrid';
import { matchVillage, invalidateVillageCache } from 'backend/sync/villages';
import { processMediaQueueStep, triggerMediaDrain } from 'backend/sync/media';
import { BOOTSTRAP_IDS } from 'backend/sync/bootstrap-ids';

const COLLECTION = 'HousesforSale';

const DEFAULT_TEST_LISTING_ID = 'A4672059';
// Stay under Wix's ~59s web-method timeout so the test panel returns cleanly
// instead of reporting "Request timed out". The work uses periodic flushes so
// the row state is durable regardless.
const TEST_PANEL_DEADLINE_MS = 50 * 1000;

export function hourlyIncremental() {
    return runSync('incremental');
}

export function nightlyFull() {
    return runSync('full');
}

export async function processMediaStep() {
    const result = await processMediaQueueStep(Date.now() + TEST_PANEL_DEADLINE_MS);
    if (result.remaining) await triggerMediaDrain();
    return result;
}

export async function testPeekFeed() {
    const results = await peekFeed(5);
    for (const r of results) console.log('[peekFeed]', r);
    return results;
}

export async function testDebugHydrate(listingId) {
    const id = listingId || DEFAULT_TEST_LISTING_ID;
    const results = await debugHydrate(id);
    for (const r of results) console.log('[debugHydrate]', r);
    return results;
}

// Fetches one MLSGrid listing, upserts it into HousesforSale with the merged
// gallery (raw https:// URLs for any new photos), then drains as many of the
// pending photos as our test-panel budget allows. Subsequent runs (or the
// hourly cron) finish the rest.
export async function testHydrateAndInsertOne(listingId) {
    const id = listingId || DEFAULT_TEST_LISTING_ID;
    invalidateVillageCache();

    const raw = await hydrateListing(id);
    if (!raw) return { error: 'not found', listingId: id };

    const village = await matchVillage(raw.SubdivisionName);
    if (!village) return { error: 'no village match', listingId: id, subdivision: raw.SubdivisionName };

    // transformListing and mergeGallery are exported from pipeline.jsw. Wix
    // wraps every exported .jsw function in a web-method proxy returning a
    // Promise when called across module boundaries, so the awaits below are
    // required even though both functions are sync at the source.
    const item = await transformListing(raw, village);
    const existing = await wixData.get(COLLECTION, item._id, { suppressAuth: true }).catch(() => null);
    const prevGallery = existing && existing.listingImageGallery;

    const merged = await mergeGallery(item.listingImageGallery, prevGallery);
    const firstWixSrc = merged.find(g => g && g.src && !g.src.startsWith('http'));
    const record = {
        ...item,
        listingImageGallery: merged,
        listingPrimaryImage: firstWixSrc ? firstWixSrc.src : item.listingPrimaryImage
    };

    if (existing) {
        await wixData.update(COLLECTION, record, { suppressAuth: true });
    } else {
        await wixData.insert(COLLECTION, record, { suppressAuth: true });
    }

    const queueResult = await processMediaQueueStep(Date.now() + TEST_PANEL_DEADLINE_MS);
    if (queueResult.remaining) await triggerMediaDrain();

    return {
        ok: true,
        action: existing ? 'updated' : 'inserted',
        listingId: id,
        storedId: record._id,
        subdivision: raw.SubdivisionName,
        village: village.villageName,
        price: record.listingPrice,
        gallerySize: merged.length,
        imagesUploaded: queueResult.processed,
        imagesFailed: queueResult.failed,
        imagesRemaining: queueResult.remaining,
        chained: !!queueResult.remaining
    };
}

// One-time population of HousesforSale from the bootstrap-ids master list.
// The test panel will likely 504 because we're inserting up to 350 rows in
// one invocation, but the work continues server-side; check SyncRuns and
// HousesforSale to see progress. Photo uploads then drain via the HTTP
// self-chain over the following several hours.
export async function runBootstrap() {
    return bootstrap(BOOTSTRAP_IDS);
}

export async function testProcessMediaStep() {
    const result = await processMediaQueueStep(Date.now() + TEST_PANEL_DEADLINE_MS);
    if (result.remaining) await triggerMediaDrain();
    console.log('[processMediaStep]', result);
    return { ...result, chained: !!result.remaining };
}
