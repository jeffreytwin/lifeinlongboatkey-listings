import wixData from 'wix-data';
import { runSync } from 'backend/sync/pipeline';
import { hydrateListing, debugHydrate, peekFeed } from 'backend/sync/mlsgrid';
import { matchVillage, invalidateVillageCache } from 'backend/sync/villages';
import { transformListing } from 'backend/sync/transform';
import { resolveGallery } from 'backend/sync/media';

const COLLECTION = 'HousesforSale';

// Replace with any active Longboat Key Stellar MLS ListingId.
// You can also copy an existing _id out of the HousesforSale collection.
const DEFAULT_TEST_LISTING_ID = 'A4672059';

export function hourlyIncremental() {
    return runSync('incremental');
}

export function nightlyFull() {
    return runSync('full');
}

export async function testPeekFeed() {
    console.log('[test] peekFeed');
    const results = await peekFeed(5);
    for (const r of results) console.log('[peekFeed]', r);
    return results;
}

export async function testDebugHydrate(listingId) {
    const id = listingId || DEFAULT_TEST_LISTING_ID;
    console.log('[test] debugHydrate', id);
    const results = await debugHydrate(id);
    for (const r of results) console.log('[debugHydrate]', r);
    return results;
}

export async function testHydrateAndInsertOne(listingId) {
    const id = listingId || DEFAULT_TEST_LISTING_ID;
    console.log('[backend/sync/run.jsw, testHydrateAndInsertOne] called with', id);

    invalidateVillageCache();

    console.log('[test] hydrating', id);
    const raw = await hydrateListing(id);
    if (!raw) {
        console.log('[test] no record returned from hydrate');
        return { error: 'not found', listingId: id };
    }

    console.log('[test] raw keys', Object.keys(raw));
    console.log('[test] raw snapshot', {
        ListingId: raw.ListingId,
        StandardStatus: raw.StandardStatus,
        MlgCanView: raw.MlgCanView,
        ListPrice: raw.ListPrice,
        BedroomsTotal: raw.BedroomsTotal,
        BathroomsTotalInteger: raw.BathroomsTotalInteger,
        LivingArea: raw.LivingArea,
        SubdivisionName: raw.SubdivisionName,
        PostalCity: raw.PostalCity,
        StreetNumber: raw.StreetNumber,
        StreetName: raw.StreetName,
        MediaCount: Array.isArray(raw.Media) ? raw.Media.length : null
    });

    const village = await matchVillage(raw.SubdivisionName);
    if (!village) {
        console.log('[test] no village match for', raw.SubdivisionName);
        return { error: 'no village match', listingId: id, subdivision: raw.SubdivisionName };
    }

    console.log('[test] typeof transformListing', typeof transformListing);
    const item = transformListing(raw, village);
    console.log('[test] item type', typeof item, 'isNull', item === null);
    console.log('[test] item keys', item ? Object.keys(item) : null);
    console.log('[test] item JSON', JSON.stringify(item));

    const { gallery, uploadedCount, errorCount } = await resolveGallery(item ? item.listingImageGallery : [], []);
    const record = {
        ...(item || {}),
        listingImageGallery: gallery,
        listingPrimaryImage: gallery.length ? gallery[0].src : (item && item.listingPrimaryImage)
    };

    console.log('[test] record keys (pre-insert)', Object.keys(record));
    console.log('[test] record JSON (pre-insert)', JSON.stringify(record));

    const intendedId = record._id;
    const existing = await wixData.get(COLLECTION, intendedId, { suppressAuth: true }).catch(() => null);
    let action;
    let inserted;
    if (existing) {
        inserted = await wixData.update(COLLECTION, record, { suppressAuth: true });
        action = 'updated';
    } else {
        inserted = await wixData.insert(COLLECTION, record, { suppressAuth: true });
        action = 'inserted';
    }

    console.log('[test] insert returned keys', inserted ? Object.keys(inserted) : null);
    console.log('[test] insert returned JSON', JSON.stringify(inserted));

    const persistedById = inserted && inserted._id
        ? await wixData.get(COLLECTION, inserted._id, { suppressAuth: true }).catch(() => null)
        : null;
    console.log('[test] persisted row JSON', JSON.stringify(persistedById));

    const result = {
        ok: true,
        action,
        listingId: id,
        intendedId,
        actualId: inserted && inserted._id,
        subdivision: raw.SubdivisionName,
        village: village.villageName,
        price: record.listingPrice,
        imagesUploaded: uploadedCount,
        imagesFailed: errorCount,
        galleryCount: gallery.length,
        persistedKeys: persistedById ? Object.keys(persistedById) : null
    };
    console.log('[backend/sync/run.jsw, testHydrateAndInsertOne] returned with', result);
    return result;
}
